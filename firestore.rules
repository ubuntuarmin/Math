rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Anti-hack: how much a numeric field is increasing in this write.
    // Returns 0 when the field is unchanged or decreasing.
    function fieldDelta(field) {
      let before = resource.data.get(field, 0);
      let after  = request.resource.data.get(field, 0);
      return after > before ? after - before : 0;
    }

    // ─── Rate-limit helpers ───────────────────────────────────────────────────
    // These read the requesting user's document to enforce sliding-window limits.
    // The client must keep the window fields up to date on every relevant write.

    // Link submissions: max 3 per hour per user.
    function linkRateLimitOk() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let windowAge = request.time.toMillis() - u.get('hourlyLinkWindowStart', 0);
      // Window expired → allow (client will reset the counter)
      return windowAge > 3600000 || u.get('hourlyLinkCount', 0) < 3;
    }

    // Reviews: max 10 per 10 seconds per user (burst-attack protection).
    function reviewRateLimitOk() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let windowAge = request.time.toMillis() - u.get('reviewWindowStart', 0);
      return windowAge > 10000 || u.get('reviewWindowCount', 0) < 10;
    }

    // Messages: max 50 per hour per user (notification spam protection).
    function messageRateLimitOk() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let windowAge = request.time.toMillis() - u.get('messageWindowStart', 0);
      return windowAge > 3600000 || u.get('messageWindowCount', 0) < 50;
    }

    // Profile updates: max 5 per hour per user.
    function profileUpdateRateLimitOk() {
      let windowAge = request.time.toMillis() - resource.data.get('profileUpdateWindowStart', 0);
      return windowAge > 3600000 || resource.data.get('profileUpdateCount', 0) < 5;
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    // Any signed-in user can read user profiles (needed for leaderboard /
    // profile modals).  Only the owner can create their own document.
    // Updates: the owner can change any field within anti-abuse limits;
    //          other authenticated users may only increment credit fields
    //          (used by the upvote flow) within the same limits.
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && request.auth.uid == userId;

      allow update: if isAuthenticated() && (
        // Owner: may update any field but credit/minute additions are capped.
        // Cap is 500 per write — covers referral bonus (150), quality bonus (50),
        // daily streak bonuses (up to 100), and appeal vote rewards (10).
        // Profile-content edits (firstName, bio, etc.) are limited to 5 per hour.
        (
          request.auth.uid == userId
          && fieldDelta('credits')      <= 500
          && fieldDelta('totalEarned')  <= 500
          && fieldDelta('weekMinutes')  <= 500
          && fieldDelta('monthMinutes') <= 500
          && fieldDelta('totalMinutes') <= 500
          // Owners can only gain referral bonus minutes once (+100) when the
          // reward flag transitions false -> true; decreases are allowed for
          // consumption by the session timer.
          && (
            fieldDelta('bonusMinutesBalance') == 0
            || (
              fieldDelta('bonusMinutesBalance') == 100
              && resource.data.get('referralOfferRewardGranted', false) == false
              && request.resource.data.get('referralOfferRewardGranted', false) == true
            )
          )
          && request.resource.data.get('weekMinutes',  0) <= 10000  // ~167 hours; prevents leaderboard abuse
          && request.resource.data.get('totalMinutes', 0) <= 999999
          // Profile-content fields are additionally rate-limited
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['firstName', 'lastName', 'bio', 'grade', 'avatarColor'])
            || profileUpdateRateLimitOk()
          )
        )
        // Other users: upvotes / referral rewards may only touch these credit fields.
        || (
           request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['credits', 'totalEarned', 'upvotedUsers', 'referrals', 'bonusMinutesBalance'])
           && fieldDelta('credits')            <= 500
           && fieldDelta('totalEarned')        <= 500
           && fieldDelta('bonusMinutesBalance') <= 100
           && (fieldDelta('bonusMinutesBalance') == 0 || fieldDelta('bonusMinutesBalance') == 100)
           && request.resource.data.get('bonusMinutesBalance', 0) >= resource.data.get('bonusMinutesBalance', 0)
         )
       );

      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Shared links ─────────────────────────────────────────────────────────
    // Authenticated users can read, submit, and interact with (upvote / report /
    // session purchase) shared links.  Only the submitter can delete their own link.
    // Link creation is rate-limited to 3 per hour per user.
    match /sharedLinks/{linkId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated()
                    && linkRateLimitOk()
                    && (
                      request.resource.data.get('type', '') != 'url'
                      || (
                        request.resource.data.get('canonicalUrl', null) is string
                        && request.resource.data.get('canonicalUrl', '').size() > 0
                      )
                    );
      allow update: if isAuthenticated(); // upvotes, reports, status changes, activeSessions
      allow delete: if isAuthenticated()
                    && (resource.data.submittedBy == request.auth.uid || isAdmin());
    }

    // Canonical URL index used for duplicate-link prevention and cleanup.
    match /sharedLinkCanonicalIndex/{indexId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin()
                    || (
                      isAuthenticated()
                      && !exists(/databases/$(database)/documents/sharedLinkCanonicalIndex/$(indexId))
                      && request.resource.data.get('canonicalUrl', null) is string
                      && request.resource.data.get('canonicalUrl', '').size() > 0
                      && request.resource.data.get('firstLinkId', null) is string
                      && request.resource.data.get('firstLinkId', '').size() > 0
                      && request.resource.data.get('submittedBy', '') == request.auth.uid
                    );
      allow update, delete: if isAdmin();
    }

    // Maintenance cursors and cleanup job state are admin-only.
    match /maintenance/{taskId} {
      allow read, write: if isAdmin();
    }

    // ─── Messages / inbox ────────────────────────────────────────────────────
    // Any authenticated user can create a message (notifications sent to
    // others on upvote, referral, link removal, etc.).
    // Creation is rate-limited to 50 per hour to prevent inbox flooding.
    // A user may only read, update, or delete messages addressed to themselves.
    match /messages/{messageId} {
      allow create: if isAuthenticated() && messageRateLimitOk();
      allow read:   if isAuthenticated() && resource.data.to == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.to == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.to == request.auth.uid;
    }

    // ─── Promotions ───────────────────────────────────────────────────────────
    // Anyone (including unauthenticated visitors) may submit a promotion request
    // via promote.html.  The hidden admin review page (281509.html) reads
    // submissions without Firebase Auth, so reads are public (security via URL
    // obscurity).  Only authenticated users may update status (approve/reject).
    // Fields are validated: htmlCode must be present and under 20 000 chars.
    match /promotions/{promotionId} {
      allow create: if request.resource.data.keys().hasAll(['htmlCode', 'status'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.htmlCode is string
                    && request.resource.data.htmlCode.size() > 0
                    && request.resource.data.htmlCode.size() <= 20000;
      // Public read so the hidden admin page (281509.html) can display submissions
      // without requiring Firebase Authentication on that page.
      allow read: if true;
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // ─── App settings ────────────────────────────────────────────────────────
    // Leaderboard reset timestamps, etc. — read-only for users.
    match /settings/{settingId} {
      allow read:  if isAuthenticated();
      allow create: if isAuthenticated()
                    && settingId == "referralOffer"
                    && request.resource.data.keys().hasOnly(['totalAwardedPairs', 'updatedAt'])
                    && request.resource.data.get('totalAwardedPairs', 0) is int
                    && request.resource.data.get('totalAwardedPairs', 0) == 1;
      allow update: if isAuthenticated()
                    && settingId == "referralOffer"
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalAwardedPairs', 'updatedAt'])
                    && request.resource.data.get('totalAwardedPairs', 0) is int
                    && resource.data.get('totalAwardedPairs', 0) is int
                    && resource.data.get('totalAwardedPairs', 0) < 35
                    && request.resource.data.get('totalAwardedPairs', 0) <= 35
                    && request.resource.data.get('totalAwardedPairs', 0) == resource.data.get('totalAwardedPairs', 0) + 1;
      allow delete: if false;
    }

    // ─── Link ratings ─────────────────────────────────────────────────────────
    // Authenticated users can read all ratings.
    // A user may only create a rating attributed to themselves.
    // Ratings are immutable once submitted.
    // Creation is rate-limited to 10 per 10 seconds to stop automated flooding.
    match /linkRatings/{ratingId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.ratedBy == request.auth.uid
                    && reviewRateLimitOk();
      allow update, delete: if false;
    }

    // ─── Admin messages ───────────────────────────────────────────────────────
    // Any authenticated user may send a message to an admin.
    // Senders and the addressed admin may read their threads.
    // Only the addressed admin (toUid) or a sender checking status may update.
    // Forwarding also runs under the admin's uid since it only fires for admins.
    match /adminMessages/{msgId} {
      allow create: if isAuthenticated()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 500;

      allow read: if isAuthenticated()
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);

      // Only the admin the message is addressed to may respond or forward it.
      // The sender cannot modify messages once created.
      allow update: if isAuthenticated()
                    && resource.data.toUid == request.auth.uid;

      allow delete: if false;
    }
  }
}

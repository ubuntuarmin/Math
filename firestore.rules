rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
          && request.auth.uid == "bnGhRvqW1YhvGek1JTLuAed6Ib63";
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    // Any signed-in user can read user profiles (needed for leaderboard /
    // profile modals).  Only the owner or admin can create the document.
    // Updates: the owner can change any field; other authenticated users may
    // only increment the credit-related fields (used by the upvote flow).
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && request.auth.uid == userId;

      allow update: if isAuthenticated() && (
        request.auth.uid == userId
        || isAdmin()
        // Upvotes award credits to another user – allow only those fields.
        || request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['credits', 'totalEarned', 'upvotedUsers'])
      );

      allow delete: if isAdmin();
    }

    // ─── Shared links ─────────────────────────────────────────────────────────
    // Authenticated users can read, submit, and interact with (upvote / report)
    // shared links.  Deletion is admin-only.
    match /sharedLinks/{linkId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // upvotes, reports, status changes
      allow delete: if isAdmin();
    }

    // ─── Messages / inbox ────────────────────────────────────────────────────
    // Any authenticated user can create a message (notifications sent to
    // others on upvote, referral, link removal, etc.).
    // A user may only read, update, or delete messages addressed to themselves.
    match /messages/{messageId} {
      allow create: if isAuthenticated();
      allow read:   if isAuthenticated() && resource.data.to == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.to == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.to == request.auth.uid;
    }

    // ─── Suggestions ─────────────────────────────────────────────────────────
    // Any authenticated user may submit a suggestion.
    // Reading the full list is restricted to admin.
    match /suggestions/{suggestionId} {
      allow create: if isAuthenticated();
      allow read:   if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── App settings ────────────────────────────────────────────────────────
    // Leaderboard reset timestamps, etc.
    match /settings/{settingId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Legacy link-submission staging collection ───────────────────────────
    match /linkSubmissions/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
